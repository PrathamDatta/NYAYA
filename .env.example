# Copy to .env (scripts/setup does this and generates a secret). Every setting is optional unless marked REQUIRED.
NYAYA_ENV=development                 # development | production
NYAYA_SECRET_KEY=change-me            # REQUIRED in production: long random string (setup script generates one)
# NYAYA_DATABASE_URL=sqlite:///...    # default: SQLite file in ./data. PostgreSQL: postgresql+psycopg://user:pass@host/db
NYAYA_DATA_DIR=./data                 # database, uploads and model cache live here
NYAYA_COOKIE_SECURE=false             # true when served over HTTPS
NYAYA_CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]   # add your deployed frontend origin if hosted separately
NYAYA_SERVE_FRONTEND=true             # FastAPI serves frontend/dist (single-process laptop deployment)

# --- models (CPU by default) ---
NYAYA_DEVICE=cpu                      # cpu | cuda | auto
NYAYA_MEMORY_BUDGET_MB=8000           # LRU-unload models to stay below this. 8 GB laptops: try 4800 (the 4.2 GB translator then swaps with the BERTs)
NYAYA_TRANSLATION_QUANTIZE_INT8=false # true: ~2.5x faster translation but NOT lower RAM (measured); quality not evaluated
# NYAYA_HF_TOKEN=                     # only needed if Hugging Face rate-limits anonymous downloads

# --- answer generation ---
NYAYA_GENERATOR_BACKEND=extractive    # extractive (default, quotes sources) | local_llm (optional local causal LM)
# NYAYA_LOCAL_LLM_REPO=Qwen/Qwen2.5-1.5B-Instruct
# NYAYA_LOCAL_LLM_REVISION=<pin a commit sha>

# --- limits ---
NYAYA_MAX_UPLOAD_MB=15
NYAYA_RATE_LIMIT_PER_MINUTE=300
NYAYA_MIN_QUERY_COVERAGE=0.6          # evidence threshold, see docs/EVALUATION.md
NYAYA_DOMAIN_THRESHOLD=0.62           # CustomInLawBERT legal-language cutoff: ADVISORY only (words the decline message)
# NYAYA_RETRIEVAL_COMPONENTS=bm25,inlegalbert,incaselawbert
# Frontend (only when hosting it separately, e.g. on Vercel):  VITE_API_BASE=https://your-backend.example
